---
import Base from '../layouts/Base.astro';
import ACompleter from '../components/ACompleter.astro';
import club from '../data/club.json';
import histoire from '../data/histoire.json';
import palmares from '../data/palmares.json';
import { infosTable } from '../lib/competitions';
---
<Base
  titre="Le club : histoire et palmarès"
  description="L’Association Sportive de Baby-foot de Marseille, fondée en 1993 : son histoire, son palmarès et ses tables de compétition."
>
  <div class="conteneur">
    <header class="entete-page">
      <h1>Le club</h1>
      <p>
        L’{club.nomLong} existe depuis 1993. Elle réunit des joueurs de tous niveaux
        autour du baby-foot, en loisir comme en compétition.
      </p>
    </header>

    <figure class="photo-equipe">
      <img src="/photos/photo-equipe.webp" width="960" height="540" alt="Une quinzaine de joueurs du club en maillot bleu posent, médailles au cou, devant une banderole de la fédération." />
      <figcaption>Les joueurs de l’ASBM, médailles au cou.</figcaption>
    </figure>

    <section class="bloc" aria-labelledby="titre-histoire">
      <h2 id="titre-histoire">Histoire</h2>
      <ol class="frise">
        {histoire.map((e) => (
          <li class:list={['frise__etape', { 'frise__etape--todo': e.aCompleter }]}>
            <p class="frise__annee nums">
              {e.aCompleter ? <ACompleter texte="Année à compléter" /> : e.annee}
            </p>
            <div>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="bloc" aria-labelledby="titre-palmares">
      <h2 id="titre-palmares">Palmarès</h2>
      <p class="doux mesure">Les titres et podiums des joueurs du club en compétition.</p>
      <div class="tableau-defilant" tabindex="0" role="region" aria-label="Tableau du palmarès, défilant horizontalement">
        <table class="palmares">
          <caption class="sr-only">Palmarès de l’ASBM</caption>
          <thead>
            <tr>
              <th scope="col">Année</th>
              <th scope="col">Compétition</th>
              <th scope="col">Catégorie</th>
              <th scope="col">Résultat</th>
              <th scope="col">Joueurs</th>
            </tr>
          </thead>
          <tbody>
            {palmares.map((p) => (
              <tr class:list={{ 'ligne-todo': p.aCompleter }}>
                <td>{p.aCompleter ? <ACompleter /> : p.annee}</td>
                <td>{p.competition}</td>
                <td>{p.categorie}</td>
                <td>{p.resultat}</td>
                <td>{p.joueurs}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="bloc" aria-labelledby="titre-materiel">
      <h2 id="titre-materiel">Les tables</h2>
      <ul class="materiel">
        {club.tables.map((t) => {
          const visuel = infosTable(t.marque);
          return (
            <li class="materiel__table">
              <h3 class="materiel__titre">
                {visuel.image && (
                  <span class="materiel__visuel"><img src={visuel.image} width="160" height="120" alt="" loading="lazy" decoding="async" /></span>
                )}
                <span class="nums">{t.nombre} {t.nombre > 1 ? 'tables' : 'table'} {t.marque}</span>
              </h3>
              <p class="materiel__texte">{t.description}</p>
            </li>
          );
        })}
      </ul>
    </section>
  </div>
</Base>

<style>
  .bloc { padding-block: var(--e-6) var(--e-7); border-top: 1px solid var(--filet); }
  .photo-equipe { margin: 0 0 var(--e-7); max-width: 60rem; }
  .photo-equipe img { width: 100%; height: auto; border-radius: var(--r-plateau); border-bottom: 6px solid var(--ciel); }
  .photo-equipe figcaption { margin-top: var(--e-2); font-size: var(--t-0); color: var(--doux); }
  .bloc h2 { font-size: var(--t-4); margin-bottom: var(--e-5); }

  .frise { list-style: none; padding: 0; position: relative; max-width: 52rem; }
  .frise::before {
    content: '';
    position: absolute;
    left: 7.25rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    background: var(--filet);
  }
  .frise__etape {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--e-6);
    padding-block: var(--e-4);
    position: relative;
  }
  .frise__etape::before {
    content: '';
    position: absolute;
    left: calc(7.25rem - 6px);
    top: calc(var(--e-4) + 0.55rem);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--balle);
    border: 3px solid var(--ciel);
  }
  .frise__etape--todo::before { border-color: var(--todo-bord); border-style: dashed; }
  .frise .frise__annee {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    color: var(--bleu);
    text-align: right;
  }
  .frise__annee :global(.a-completer) { font-family: var(--f-texte); font-size: 0.75rem; white-space: normal; display: inline-block; text-align: left; }
  .frise h3 { font-family: var(--f-texte); font-weight: 700; font-size: var(--t-2); letter-spacing: 0; line-height: 1.3; }
  .frise p { margin-top: var(--e-1); color: var(--doux); max-width: 58ch; }

  .tableau-defilant { overflow-x: auto; margin-top: var(--e-5); }
  .palmares { width: 100%; min-width: 40rem; text-align: left; }
  .palmares th, .palmares td { padding: var(--e-3) var(--e-4) var(--e-3) 0; border-bottom: 1px solid var(--filet); vertical-align: top; }
  .palmares th { font-size: var(--t-0); color: var(--doux); font-weight: 700; }
  .ligne-todo td { color: var(--doux); font-style: italic; }
  .ligne-todo td:first-child { font-style: normal; }

  .materiel { list-style: none; padding: 0; display: grid; gap: var(--e-5); }
  /* Le titre porte l'illustration de la table, placée à gauche du titre et du texte */
  .materiel__table {
    position: relative;
    display: grid;
    align-content: center;
    gap: var(--e-1);
    min-height: 120px;
    padding-left: calc(160px + var(--e-5));
    padding-bottom: var(--e-5);
    border-bottom: 1px solid var(--filet);
  }
  .materiel__table:last-child { border-bottom: 0; padding-bottom: 0; }
  .materiel__titre {
    font-family: var(--f-display);
    font-size: var(--t-3);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
  }
  .materiel__visuel {
    position: absolute;
    left: 0;
    top: 0;
    width: 160px;
    height: 120px;
    border-radius: var(--r-plateau);
    background: #fff;
    box-shadow: 0 0 0 1px var(--filet);
    overflow: hidden;
  }
  .materiel__visuel img { width: 100%; height: 100%; object-fit: contain; }
  .materiel__texte { color: var(--doux); }
  @media (min-width: 64rem) {
    .materiel__texte { white-space: nowrap; }
  }

  @media (max-width: 34rem) {
    .materiel__table { min-height: 84px; padding-left: calc(112px + var(--e-4)); }
    .materiel__visuel { width: 112px; height: 84px; }
    .frise::before { left: 7px; }
    .frise__etape { grid-template-columns: 1fr; gap: var(--e-2); padding-left: var(--e-6); }
    .frise__etape::before { left: 1px; top: calc(var(--e-4) + 0.3rem); }
    .frise .frise__annee { text-align: left; font-size: 1.6rem; }
  }
</style>
