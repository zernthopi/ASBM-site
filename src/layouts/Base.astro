---
import '@fontsource/big-shoulders-display/latin-700';
import '@fontsource/big-shoulders-display/latin-800';
import '@fontsource-variable/atkinson-hyperlegible-next/wght';
import '../styles/global.css';
import policeTitres from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-800-normal.woff2?url';
import policeTexte from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
import Entete from '../components/Entete.astro';
import Pied from '../components/Pied.astro';
import club from '../data/club.json';

interface Props {
  titre: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}
const { titre, description, jsonLd } = Astro.props;
const titreComplet = titre === club.nomUsage ? `${club.nomUsage} (${club.nomCourt})` : `${titre} | ${club.nomCourt} Baby-foot Marseille`;
const canonique = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <!-- GitHub Pages n'envoie pas public/_headers : la politique de sécurité passe donc par ces balises. -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'none'; frame-src https://www.openstreetmap.org; object-src 'none'; base-uri 'self'; form-action 'self'" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    {canonique && <link rel="canonical" href={canonique} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    {Astro.site && <meta property="og:image" content={new URL('/photos/photo-equipe.webp', Astro.site).href} />}
    <link rel="preload" href={policeTitres} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={policeTexte} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0b1d3a" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={`${club.nomUsage} (${club.nomCourt})`} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <Entete />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Pied />
  </body>
</html>
