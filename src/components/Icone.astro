---
// Jeu d'icônes dessinées à la main : trait unique de 1,8 px sur une grille de 24 px.
interface Props {
  nom:
    | 'lieu' | 'horloge' | 'tram' | 'metro' | 'telephone' | 'email'
    | 'externe' | 'document' | 'menu' | 'calendrier' | 'groupe'
    | 'bulle' | 'photo' | 'video' | 'trophee' | 'filtre' | 'cube' | 'fermer';
  titre?: string;
}
const { nom, titre } = Astro.props;

const chemins: Record<Props['nom'], string> = {
  lieu: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  horloge: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  tram: '<rect x="6" y="5" width="12" height="12" rx="3"/><path d="M6 11h12M9 2h6M12 2v3M8.5 17 7 21M15.5 17 17 21"/>',
  metro: '<circle cx="12" cy="12" r="9"/><path d="M8 16V8l4 5 4-5v8"/>',
  telephone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  externe: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  document: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  calendrier: '<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  groupe: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.8a3.5 3.5 0 0 1 0 6.4M18.5 14a6.5 6.5 0 0 1 3 6"/>',
  bulle: '<path d="M4 5h16v11H10l-5 4v-4H4z"/><path d="M8 9.5h8M8 12.5h5"/>',
  photo: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7l1.5-3h5L16 7"/><circle cx="12" cy="13.5" r="3.5"/>',
  video: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3z"/>',
  trophee: '<path d="M8 4h8v5a4 4 0 0 1-8 0zM8 6H5v1a3 3 0 0 0 3 3M16 6h3v1a3 3 0 0 1-3 3M12 13v4M8.5 20h7M10 17h4"/>',
  filtre: '<path d="M4 5h16l-6 7v6l-4 2v-8z"/>',
  cube: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12l8-4.5M12 12v9M12 12 4 7.5"/>',
  fermer: '<path d="M6 6l12 12M18 6 6 18"/>',
};
---
<svg
  class="icone"
  viewBox="0 0 24 24"
  aria-hidden={titre ? undefined : 'true'}
  role={titre ? 'img' : undefined}
  aria-label={titre}
  focusable="false"
  set:html={chemins[nom]}
/>
