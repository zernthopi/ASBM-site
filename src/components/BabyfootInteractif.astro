---
// Baby-foot jouable : le script est injecté en ligne (pas de module),
// pour fonctionner aussi en ouvrant la version locale par double-clic.
import jeu from '../scripts/babyfoot.js?raw';
---
<div class="bf" data-babyfoot>
  <div class="bf__scene" data-bf-scene role="group" aria-label="Baby-foot interactif : vous jouez les jaunes contre les noirs de l’ordinateur" aria-describedby="bf-consigne">
    <canvas aria-hidden="true"></canvas>
    <div class="bf__accueil">
      <button type="button" class="bouton bf__jouer" data-bf-jouer>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="bf__icone"><path d="M8 5.5v13l10.5-6.5z" /></svg>
        Jouer une partie
      </button>
      <p class="bf__sous">À la souris, au doigt ou au clavier</p>
    </div>
    <div class="bf__fin sur-marine" data-bf-fin role="alertdialog" aria-labelledby="bf-fin-titre" aria-describedby="bf-fin-texte" hidden>
      <p class="bf__fin-titre" id="bf-fin-titre">Perdu <span class="nums" data-bf-fin-score>0 – 10</span></p>
      <p class="bf__fin-texte" id="bf-fin-texte">Marre de te faire battre par quelqu’un qui joue plus carré que toi&nbsp;? Viens t’entraîner au club&nbsp;!</p>
      <div class="bf__fin-actions">
        <a class="bouton" href="/acces">Venir s’entraîner</a>
        <button type="button" class="bouton bouton--contour" data-bf-rejouer>Rejouer</button>
      </div>
    </div>
  </div>

  <div class="bf__barre">
    <p class="bf__score nums">
      <span class="bf__equipe bf__equipe--b">Vous</span>
      <strong data-bf-score-b>0</strong>
      <span aria-hidden="true">–</span><span class="sr-only">à</span>
      <strong data-bf-score-r>0</strong>
      <span class="bf__equipe bf__equipe--r">Noirs</span>
    </p>
    <button type="button" class="bf__quitter" data-bf-quitter>Quitter la partie</button>
  </div>
  <p class="bf__consigne" id="bf-consigne" data-bf-consigne>
    Glissez une barre jaune pour la déplacer, tirez-la vers l’arrière pour frapper. Quand la balle s’arrête devant un de vos joueurs, tracez sa trajectoire.
  </p>
  <p class="sr-only" aria-live="polite" data-bf-annonce></p>
</div>

<script is:inline set:html={jeu}></script>

<style>
  .bf { width: 100%; }
  .bf__scene { position: relative; border-radius: var(--r-plateau); outline-offset: 6px; }
  .bf__scene:focus-visible { outline: 3px solid var(--ciel-clair); }
  .bf canvas { display: block; width: 100%; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .bf--jeu canvas { touch-action: none; cursor: grab; }
  .bf--saisie canvas { cursor: grabbing; }

  .bf__accueil {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    pointer-events: none;
  }
  .bf__accueil > * { pointer-events: auto; }
  .bf--jeu .bf__accueil { display: none; }
  .bf__jouer {
    font-size: 1.5rem;
    min-height: 56px;
    padding-inline: var(--e-6);
    box-shadow: 0 6px 0 #0b1d3a, 0 14px 30px rgb(0 0 0 / 0.35);
  }
  .bf__jouer:active { transform: translateY(3px); box-shadow: 0 3px 0 #0b1d3a, 0 8px 18px rgb(0 0 0 / 0.35); }
  .bf__icone { width: 1.1em; height: 1.1em; fill: currentColor; }
  .bf__sous {
    background: rgb(11 29 58 / 0.88);
    color: #ffffff;
    font-size: var(--t-0);
    font-weight: 700;
    padding: 0.2rem 0.7rem;
    border-radius: var(--r-petit);
  }

  /* Défaite à 10 buts : invitation à venir au club */
  .bf__fin {
    position: absolute;
    inset: 8% 10%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--e-3);
    padding: var(--e-5);
    text-align: center;
    background: rgb(11 29 58 / 0.94);
    border: 3px solid #ffd84d;
    border-radius: var(--r-plateau);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
  }
  .bf__fin[hidden] { display: none; }
  .bf__fin-titre {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(1.8rem, 1.2rem + 3vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
    color: #ffd84d;
  }
  .bf__fin-texte { color: #ffffff; font-size: var(--t-2); font-weight: 700; max-width: 30ch; line-height: 1.3; }
  .bf__fin-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--e-3); margin-top: var(--e-2); }
  @media (max-width: 34rem) {
    .bf__fin { inset: 4%; padding: var(--e-4); }
    .bf__fin-texte { font-size: var(--t-1); }
  }
  .bf--trace canvas { cursor: crosshair; }

  .bf__barre {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    margin-top: var(--e-3);
    flex-wrap: wrap;
  }
  .bf--jeu .bf__barre { display: flex; }
  .bf__score {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1;
    text-transform: uppercase;
    color: #ffffff;
  }
  .bf__score strong {
    display: inline-grid;
    place-items: center;
    min-width: 2.2rem;
    height: 2.4rem;
    border-radius: var(--r-petit);
    background: #ffffff;
    color: var(--marine);
    font-size: 1.8rem;
  }
  .bf__equipe--b { color: #ffd84d; }
  .bf__equipe--r { color: #c9ced6; }
  .bf__quitter {
    min-height: 44px;
    padding: 0 var(--e-4);
    border: 2px solid #ffffff;
    border-radius: var(--r-petit);
    background: transparent;
    color: #ffffff;
    font-weight: 700;
    cursor: pointer;
  }
  .bf__quitter:hover { background: #ffffff; color: var(--marine); }
  .bf__quitter:focus-visible { outline: 3px solid var(--ciel-clair); outline-offset: 3px; }
  .bf__consigne {
    margin-top: var(--e-3);
    font-size: var(--t-0);
    color: var(--sur-marine-doux);
    max-width: 60ch;
  }
</style>
