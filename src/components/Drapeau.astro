---
// Petit drapeau hébergé sur le site. Décoratif par défaut (le nom du pays est écrit à côté) ;
// passer `nomme` quand le drapeau remplace le nom du pays.
import { fichierDrapeau } from '../lib/competitions';
import { nomPays } from '../lib/format';

interface Props { code: string | null | undefined; nomme?: boolean }
const { code, nomme = false } = Astro.props;
const src = fichierDrapeau(code);
const nom = code ? nomPays(code) : '';
---
{src && (
  <img
    class="drapeau"
    src={src}
    width="20"
    height="15"
    alt={nomme ? nom : ''}
    title={nomme ? nom : undefined}
    loading="lazy"
    decoding="async"
  />
)}

<style>
  .drapeau {
    display: inline-block;
    width: 1.25em;
    height: auto;
    aspect-ratio: 4 / 3;
    vertical-align: -0.12em;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgb(11 29 58 / 0.18);
    object-fit: cover;
  }
</style>
