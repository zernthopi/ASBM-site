---
// Photos publiées par le club sur sa page Facebook.
import photos from '../data/photos.json';
---
<div class="galerie">
  {photos.map((p, i) => (
    <figure class={`galerie__item galerie__item--${i + 1}`}>
      <img src={p.fichier} width={p.largeur} height={p.hauteur} alt={p.alt} loading="lazy" decoding="async" />
      <figcaption>{p.legende}</figcaption>
    </figure>
  ))}
</div>

<style>
  .galerie {
    display: grid;
    grid-template-columns: 1.3fr 1fr 0.9fr;
    grid-template-rows: clamp(15rem, 27vw, 22rem) clamp(11rem, 18vw, 15rem);
    gap: var(--e-3);
  }
  .galerie__item { position: relative; margin: 0; overflow: hidden; border-radius: var(--r-plateau); background: var(--surface); }
  .galerie__item img { width: 100%; height: 100%; object-fit: cover; }
  .galerie__item--1 { grid-column: 1 / 3; grid-row: 1; }
  .galerie__item--1 img { object-position: 50% 30%; }
  .galerie__item--2 { grid-column: 3; grid-row: 1 / 3; }
  .galerie__item--3 { grid-column: 1; grid-row: 2; }
  .galerie__item--4 { grid-column: 2; grid-row: 2; }
  .galerie__item--4 img { object-position: 50% 30%; }
  figcaption {
    position: absolute;
    left: var(--e-3);
    bottom: var(--e-3);
    padding: 0.25rem 0.6rem;
    border-radius: var(--r-petit);
    background: rgb(11 29 58 / 0.9);
    color: #ffffff;
    font-size: var(--t-0);
    font-weight: 700;
  }
  @media (max-width: 44rem) {
    .galerie { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .galerie__item { grid-column: auto !important; grid-row: auto !important; aspect-ratio: 4 / 5; }
    .galerie__item--1 { grid-column: 1 / -1 !important; aspect-ratio: 16 / 9; }
    .galerie__item--3 { grid-column: 1 / -1 !important; aspect-ratio: 4 / 3; }
  }
</style>
